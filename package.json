{
  "name": "tourism-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme touristique full-stack (mobile React Native, dashboard Next.js, backend Next.js API, MongoDB)",
  "workspaces": [
    "shared",
    "backend",
    "realtime",
    "worker",
    "dashboard",
    "mobile"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:dashboard": "npm run dev --workspace dashboard",
    "dev:mobile": "npm run start --workspace mobile",
    "build": "npm run build --workspace backend && npm run build --workspace dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "dev:realtime": "npm run dev --workspace realtime",
    "dev:worker": "npm run dev --workspace worker",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f --tail=100",
    "stack:ps": "docker compose ps",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "test:scaling": "bash scripts/test-scaling.sh",
    "test:load": "node scripts/load-test.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "puppeteer-core": "^24.43.1"
  }
}
