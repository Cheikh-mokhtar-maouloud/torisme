# Dependencies
node_modules/
.pnp
.pnp.*

# Builds
.next/
out/
build/
dist/
*.tsbuildinfo

# Environment — NE JAMAIS COMMITER DE SECRETS
.env
.env.*
!.env.example
realtime/.env

# Expo / React Native
.expo/
.expo-shared/
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tests / coverage
coverage/
.nyc_output/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Vercel
.vercel

# Fichiers téléversés en développement (stockage local)
backend/.uploads/*
!backend/.uploads/.gitignore

# Caches
.turbo/
.eslintcache

# Secrets du worker
worker/.env

# Sauvegardes : elles contiennent la base entiere, donc des donnees
# personnelles. Un dump commite est une fuite permanente, y compris apres
# suppression du fichier — l'historique Git le conserve.
# Sortie de build des scripts d'exploitation.
**/dist-ops/

backups/*
!backups/.gitkeep

# Certificats TLS : la cle privee ne doit jamais entrer dans le depot.
docker/nginx/certs/*
!docker/nginx/certs/.gitkeep

# Surcharge Docker locale (ports de developpement).
docker-compose.override.yml
