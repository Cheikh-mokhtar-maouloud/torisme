APP_ENV=development

# Redis. Obligatoire : sans file, le worker n'a rien a faire.
REDIS_URL=
# Doit etre identique a celui du backend.
REDIS_KEY_PREFIX=tourism

# Racine de l'API. Le worker n'a NI l'URI MongoDB NI la cle du fournisseur
# d'emails : il passe par les routes internes du backend, qui detient les
# secrets. Compromettre le worker ne donne donc acces ni aux donnees ni au
# compte d'envoi.
BACKEND_URL=http://localhost:4000
# Doit etre identique a INTERNAL_API_SECRET du backend.
# Generer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# Taches simultanees. Modeste a dessein : la limite reelle est le quota par
# seconde du fournisseur d'emails, pas le worker.
WORKER_CONCURRENCY=5
# Periode de l'entretien (statuts des sejours et excursions termines).
MAINTENANCE_INTERVAL_MINUTES=60
LOG_LEVEL=info
