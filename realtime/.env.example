# ---------------------------------------------------------------------------
# Service temps réel (Socket.IO)
# Copier vers .env. Ne jamais commiter de valeurs réelles.
# ---------------------------------------------------------------------------

PORT=4100
APP_ENV=development

# LE MÊME secret que le backend : ce service ne fait que vérifier les jetons
# d'accès déjà émis. Une valeur divergente rend toute connexion impossible.
JWT_SECRET=identique_a_celui_du_backend

# Secret partagé permettant au backend de publier des événements.
# DISTINCT de JWT_SECRET : ce sont deux relations de confiance différentes.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REALTIME_PUBLISH_SECRET=remplacer_par_un_secret_aleatoire_de_32_caracteres_minimum

# Origines autorisées pour la poignée de main (dashboard).
# L'application mobile n'envoie pas d'origine et n'est pas concernée.
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info

# --- Redis -----------------------------------------------------------------
# Présent, le service s'abonne au canal du backend et reçoit les événements de
# TOUTES ses instances. Absent, il ne reçoit que les appels HTTP /emit.
REDIS_URL=
# Doit être identique à celui du backend : il nomme le canal pub/sub.
REDIS_KEY_PREFIX=tourism

# Cle precedente, le temps d'une rotation. Doit suivre celle du backend, sans
# quoi changer JWT_SECRET couperait tous les sockets alors que l'API resterait
# accessible — une panne partielle bien plus difficile a diagnostiquer.
JWT_SECRET_PREVIOUS=
