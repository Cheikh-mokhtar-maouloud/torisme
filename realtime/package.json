{
  "name": "realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Service Socket.IO — diffusion temps réel vers le mobile et le dashboard",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:realtime": "node --env-file=.env scripts/realtime-test.mjs"
  },
  "dependencies": {
    "@tourism/shared": "*",
    "ioredis": "^5.11.1",
    "jose": "^6.1.0",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
