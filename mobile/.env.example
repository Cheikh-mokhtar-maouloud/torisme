# ---------------------------------------------------------------------------
# Application mobile — variables d'environnement
# Copier vers .env.local. Ne jamais commiter de valeurs réelles.
#
# ATTENTION : tout ce qui est préfixé EXPO_PUBLIC_ est intégré au bundle et
# donc lisible par n'importe quel utilisateur. Aucun secret ici.
# ---------------------------------------------------------------------------

# Sur un appareil physique, localhost pointe vers le téléphone : utiliser
# l'IP locale de la machine de développement (ex. http://192.168.1.10:4000).
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_APP_ENV=development

# Phase 6 — carte (clé restreinte par bundle id / package name)
# EXPO_PUBLIC_MAPS_API_KEY=
