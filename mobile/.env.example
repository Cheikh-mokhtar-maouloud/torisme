# ---------------------------------------------------------------------------
# Application mobile — variables d'environnement
# Copier vers .env.local. Ne jamais commiter de valeurs réelles.
#
# ATTENTION : tout ce qui est préfixé EXPO_PUBLIC_ est intégré au bundle et
# donc lisible par n'importe quel utilisateur. Aucun secret ici.
# ---------------------------------------------------------------------------

# Sur un appareil physique, localhost pointe vers le téléphone : utiliser
# l'IP locale de la machine de développement (ex. http://192.168.1.10:4000).
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_APP_ENV=development

# --- Temps réel -----------------------------------------------------------
# Service Socket.IO. Laisser vide désactive les mises à jour instantanées ;
# l'application reste pleinement fonctionnelle.
EXPO_PUBLIC_REALTIME_URL=http://localhost:4100

# --- Carte ----------------------------------------------------------------
# Clé Google Maps, requise UNIQUEMENT pour les compilations natives Android.
# Dans Expo Go, la carte fonctionne sans clé ; iOS utilise Apple Maps.
#
# La clé est intégrée au bundle et extractible de tout APK : elle DOIT être
# restreinte au nom de paquet (com.tourismplatform.app) et à l'empreinte de
# signature dans la console Google Cloud, sinon elle est réutilisable par
# n'importe qui et facturée sur votre compte.
#
# Console Google Cloud → APIs & Services → Credentials → Create API key,
# puis activer « Maps SDK for Android ».
# EXPO_PUBLIC_MAPS_API_KEY=
