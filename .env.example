# Variables de la pile Docker (Phase 15).
#
# Copier vers `.env` a la racine, puis renseigner. Ce fichier n'est PAS lu par
# les applications en developpement : chaque workspace garde son propre .env.
# Celui-ci ne sert qu'a `docker compose`.
#
# Generer un secret :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

APP_ENV=production
LOG_LEVEL=info

# --- Domaines ----------------------------------------------------------------
API_DOMAIN=api.exemple.mr
DASHBOARD_DOMAIN=admin.exemple.mr
REALTIME_DOMAIN=ws.exemple.mr

PUBLIC_BASE_URL=https://api.exemple.mr
APP_PUBLIC_URL=https://admin.exemple.mr
NEXT_PUBLIC_REALTIME_URL=https://ws.exemple.mr
CORS_ORIGINS=https://admin.exemple.mr

# --- MongoDB -----------------------------------------------------------------
# Aucun port n'est publie : la base n'est joignable que depuis le reseau interne.
MONGO_ROOT_USER=tourism
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=tourism
# Bien au-dessus du defaut de 5, prevu pour le serverless. Une instance unique
# supporte — et reclame — un pool nettement plus large.
MONGODB_MAX_POOL_SIZE=25

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_KEY_PREFIX=tourism
REDIS_MAXMEMORY=256mb

# --- Secrets applicatifs -----------------------------------------------------
# Trois relations de confiance distinctes. Voir docs/security.md.
JWT_SECRET=
# Renseigne UNIQUEMENT pendant une rotation, puis retire.
JWT_SECRET_PREVIOUS=
REALTIME_PUBLISH_SECRET=
INTERNAL_API_SECRET=

# --- Stockage et emails ------------------------------------------------------
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=5
MAINTENANCE_INTERVAL_MINUTES=60
