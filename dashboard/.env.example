# ---------------------------------------------------------------------------
# Dashboard administrateur — variables d'environnement
# Copier vers .env.local. Ne jamais commiter de valeurs réelles.
# ---------------------------------------------------------------------------

# URL du backend API. Le préfixe NEXT_PUBLIC_ expose la valeur au navigateur :
# n'y placer QUE des données non sensibles.
NEXT_PUBLIC_API_URL=http://localhost:4000

APP_ENV=development
