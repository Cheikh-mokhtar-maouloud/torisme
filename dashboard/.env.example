# ---------------------------------------------------------------------------
# Dashboard administrateur — variables d'environnement
# Copier vers .env.local. Ne jamais commiter de valeurs réelles.
# ---------------------------------------------------------------------------

# URL du backend API. Non préfixée NEXT_PUBLIC_ : les appels partent du serveur
# Next (server components et server actions), jamais du navigateur. L'URL
# interne de l'API n'a donc pas à être exposée dans le bundle client.
API_URL=http://localhost:4000

APP_ENV=development

# Service temps réel. Préfixée NEXT_PUBLIC_ car la connexion Socket.IO part du
# navigateur — c'est la seule URL que le client doit connaître.
# Laisser vide désactive les mises à jour en direct.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4100
