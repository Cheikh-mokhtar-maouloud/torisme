# ---------------------------------------------------------------------------
# Backend API — variables d'environnement
#
# Copier ce fichier vers .env.local (développement) et NE JAMAIS le commiter
# rempli. Les valeurs ci-dessous sont des exemples, pas des secrets réels.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=development

# --- Base de données ------------------------------------------------------
# MongoDB Atlas : mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tourism
MONGODB_DB_NAME=tourism

# --- Authentification -----------------------------------------------------
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplacer_par_un_secret_aleatoire_de_32_caracteres_minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS -----------------------------------------------------------------
# Origines autorisées, séparées par des virgules (dashboard, web local…)
CORS_ORIGINS=http://localhost:3000

# --- Observabilité --------------------------------------------------------
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Ajoutés lors des phases suivantes — laissés ici pour référence :
#
# Phase 7  — stockage images
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
#
# Phase 11 — emails
# MAIL_PROVIDER=
# MAIL_API_KEY=
# MAIL_FROM=
#
# Phase 13 — Redis / BullMQ
# REDIS_URL=redis://127.0.0.1:6379
#
# Phase 23 — paiement
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ---------------------------------------------------------------------------
