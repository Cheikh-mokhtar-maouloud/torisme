# ---------------------------------------------------------------------------
# Backend API — variables d'environnement
#
# Copier ce fichier vers .env.local (développement) et NE JAMAIS le commiter
# rempli. Les valeurs ci-dessous sont des exemples, pas des secrets réels.
#
# En production, ces variables se définissent dans l'interface du fournisseur
# (Vercel → Settings → Environment Variables), jamais dans un fichier commité.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=development

# --- Base de données ------------------------------------------------------
# Local  : mongodb://127.0.0.1:27017/tourism
# Atlas  : mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
#
# Le mot de passe doit être encodé pour l'URL : un « @ » ou un « / » brut
# casserait l'analyse de la chaîne de connexion.
MONGODB_URI=mongodb://127.0.0.1:27017/tourism
MONGODB_DB_NAME=tourism

# Connexions maximales par instance.
# 5 en serverless (chaque instance ouvre son propre pool et le quota Atlas M0
# est de 500 connexions) ; 20 à 50 sur un serveur unique de longue durée.
MONGODB_MAX_POOL_SIZE=5

# --- Authentification -----------------------------------------------------
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Un secret DIFFÉRENT par environnement : un jeton de recette ne doit jamais
# être valide en production.
JWT_SECRET=remplacer_par_un_secret_aleatoire_de_32_caracteres_minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS -----------------------------------------------------------------
# Origines web autorisées, séparées par des virgules, SANS barre oblique finale.
# En production : https://admin.votre-domaine.mr
# L'application mobile n'envoie pas d'en-tête Origin et n'est pas concernée.
CORS_ORIGINS=http://localhost:3000

# --- Stockage des images --------------------------------------------------
# local      : écrit dans backend/.uploads, servi par /api/files (DÉVELOPPEMENT).
# cloudinary : production. Le stockage local y est refusé — un système de
#              fichiers serverless est éphémère, les images disparaîtraient
#              au redéploiement.
STORAGE_PROVIDER=local

# Racine publique de l'API, utilisée pour construire les URL du stockage local.
PUBLIC_BASE_URL=http://localhost:4000

# Requis avec STORAGE_PROVIDER=cloudinary (Dashboard Cloudinary → Settings → API Keys)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Emails ---------------------------------------------------------------
# console : journalise sans envoyer (DÉVELOPPEMENT). Refusé en production —
#           les messages ne partiraient jamais, panne silencieuse.
# resend  : production. https://resend.com → API Keys, puis vérifier le domaine.
MAIL_PROVIDER=console

# Requis avec MAIL_PROVIDER=resend
# MAIL_API_KEY=re_...
# MAIL_FROM=Tourism Platform <bonjour@votre-domaine.mr>

# Racine des liens envoyés par email (réinitialisation…). Pointe vers
# l'application publique, pas vers l'API.
APP_PUBLIC_URL=http://localhost:3000

# --- Observabilité --------------------------------------------------------
# debug en développement, info en production (debug journaliserait chaque requête).
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Création du premier administrateur (script ponctuel, non lu par l'application) :
#   ADMIN_EMAIL=admin@exemple.mr ADMIN_PASSWORD=… ADMIN_NAME="…" \
#     npm run create-admin --workspace backend
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Ajoutés lors des phases suivantes — laissés ici pour référence :
#
#
# Phase 13 — Redis / BullMQ
# REDIS_URL=redis://127.0.0.1:6379
#
# Phase 23 — paiement
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ---------------------------------------------------------------------------

# Clé PRECEDENTE, acceptée en verification seulement, le temps d'une rotation.
# Voir docs/security.md, section « Rotation d'un secret ».
# A retirer une fois JWT_ACCESS_TTL ecoule : la laisser en place maintiendrait
# valide le secret que la rotation etait censee retirer du service.
JWT_SECRET_PREVIOUS=

# --- Connexion Google -------------------------------------------------------
# Identifiant client OAuth, servant d'audience attendue des jetons d'identité.
# Doit être identique à EXPO_PUBLIC_GOOGLE_CLIENT_ID côté mobile.
#
# Laissé vide, la route /api/auth/google refuse les requêtes et l'application
# n'affiche pas le bouton. Le serveur démarre normalement sans lui.
# GOOGLE_CLIENT_ID=

# --- Envoi de courriels -----------------------------------------------------
# console : les messages sont écrits dans les journaux, jamais expédiés. C'est
#           la valeur par défaut, et elle est refusée en production.
# smtp    : n'importe quel compte de messagerie existant. Aucun domaine à
#           posséder ni à vérifier — le plus simple pour démarrer.
# resend  : service dédié, meilleure délivrabilité, mais exige un domaine
#           vérifié pour écrire à des adresses quelconques.
MAIL_PROVIDER=console
MAIL_FROM=

# --- SMTP (si MAIL_PROVIDER=smtp) -------------------------------------------
# Exemple avec Gmail :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=votre.adresse@gmail.com
#   SMTP_PASSWORD=  <- mot de passe d'application, PAS celui du compte
#   MAIL_FROM=votre.adresse@gmail.com
#
# Le mot de passe d'application se crée sur myaccount.google.com/apppasswords ;
# il exige la validation en deux étapes. C'est un secret distinct, révocable
# seul : une fuite du serveur ne livre pas la boîte entière.
#
# À savoir : Gmail plafonne à environ 500 messages par jour et finit par
# suspendre un compte qui en abuse. Convient au développement et aux premiers
# utilisateurs, pas à un envoi en masse.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Resend (si MAIL_PROVIDER=resend) ---------------------------------------
MAIL_API_KEY=
